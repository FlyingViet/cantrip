<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>
    <!-- The app's own group stays first so existing Keychain items keep their default group. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.itzhoang.hermbot</string>
        <string>$(AppIdentifierPrefix)com.itzhoang.hermbot.shared</string>
    </array>
</dict>
</plist>
