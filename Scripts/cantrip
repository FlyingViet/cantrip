#!/usr/bin/env python3
"""cantrip — command-line client for the Cantrip app.

Usage:
  cantrip "why is the sky blue"
  cat build.log | cantrip "why did this fail?"
  cantrip --backend claude "review this diff" < changes.diff
  cantrip runs [session-or-run-id]

If the app isn't running, the exact bundle next to this script's repo is
launched (never LaunchServices' pick among stale copies), with a warning
when that bundle was built from older source than the checkout.
"""
import json
import os
import socket
import subprocess
import sys
import time

SOCKET = os.path.expanduser("~/.cache/Cantrip/cantrip.sock")
RUNS_DIR = os.path.expanduser("~/.cache/Cantrip/runs")


def repo_dir():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def connect():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(SOCKET)
    return sock


def quiet_output(args):
    try:
        return subprocess.run(args, capture_output=True, text=True,
                              timeout=10).stdout.strip()
    except Exception:
        return ""


def source_identity(repo):
    """Matches the Makefile's CantripBuildIdentity format (dirty trees
    get a diff checksum appended, so different edits read differently)."""
    ident = quiet_output(["git", "-C", repo, "describe", "--always", "--dirty"])
    if ident.endswith("-dirty"):
        try:
            digest = subprocess.run(
                f"git -C '{repo}' diff HEAD | cksum | cut -d' ' -f1",
                shell=True, capture_output=True, text=True, timeout=10,
            ).stdout.strip()
            if digest:
                ident += "-" + digest
        except Exception:
            pass
    return ident


def launch_app():
    """Launch the repo's own Cantrip.app by exact path; returns a
    connected socket, or None."""
    pids = quiet_output(["pgrep", "-x", "Cantrip"])
    if pids:
        pid = pids.split()[0]
        print(f"cantrip: a Cantrip process is already running (pid {pid}) "
              f"but its socket isn't answering — it may be hung. "
              f"Try `kill {pid}` and re-run.", file=sys.stderr)
        return None
    repo = repo_dir()
    app = os.path.join(repo, "Cantrip.app")
    if not os.path.isdir(app):
        return None
    build = quiet_output(["defaults", "read",
                          os.path.join(app, "Contents", "Info"),
                          "CantripBuildIdentity"])
    source = source_identity(repo)
    if build and source and build != source:
        print(f"cantrip: note — app built from {build}, source is at {source}."
              f" Run `cantrip-rebuild` (or `make -C {repo} run`) to update.",
              file=sys.stderr)
    print(f"cantrip: app not running — launching {app}", file=sys.stderr)
    subprocess.run(["open", "-g", app], check=False)
    for _ in range(60):  # up to ~15s for the socket to appear
        time.sleep(0.25)
        try:
            return connect()
        except OSError:
            continue
    return None


def load_run_events(path):
    events = []
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                try:
                    events.append(json.loads(line))
                except json.JSONDecodeError:
                    pass  # A process exit may leave one partial tail record.
    except OSError:
        pass
    return events


def event_summary(event):
    kind = event.get("kind", "unknown")
    if kind == "turn_started":
        return f"{event.get('mode', 'single')} · {event.get('prompt', '')[:100]}"
    if kind == "tool_activity":
        activity = event.get("activity", {})
        return (f"{activity.get('state', '?')} · "
                f"{activity.get('toolName', 'tool')} · "
                f"{activity.get('title', '')}")
    if kind == "artifact":
        artifact = event.get("artifact", {})
        return f"{artifact.get('kind', 'file')} · {artifact.get('path', '')}"
    if kind == "queue_added" or kind == "queue_removed":
        return event.get("queueItem", {}).get("text", "")[:100]
    if kind == "attempt":
        return f"#{event.get('attemptNumber', '?')} · {event.get('reason', '')}"
    if kind == "usage":
        usage = event.get("usage", {})
        return (f"{usage.get('backend', '')} · "
                f"{usage.get('inputTokens', 0)} in / "
                f"{usage.get('outputTokens', 0)} out · "
                f"${usage.get('costUSD', 0):.4f}")
    if kind == "approval":
        return (f"{event.get('decision', '?')} · {event.get('tool', '')} · "
                f"{event.get('decidedBy', '')}")
    if kind in ("interruption", "cancelled"):
        return event.get("reason", "")
    if kind == "result":
        duration = event.get("durationMS")
        suffix = f" · {duration / 1000:.1f}s" if isinstance(duration, int) else ""
        return f"{event.get('status', '?')}{suffix}"
    if kind == "output":
        text = event.get("text", "").replace("\n", " ")
        return text[:100]
    if kind == "message_started":
        return f"{event.get('role', '?')} · {event.get('text', '')[:100]}"
    return ""


def inspect_runs(identifier=None):
    try:
        paths = [
            os.path.join(RUNS_DIR, name)
            for name in os.listdir(RUNS_DIR)
            if name.endswith(".jsonl")
        ]
    except OSError:
        paths = []
    if not paths:
        print("cantrip: no durable runs recorded", file=sys.stderr)
        return 1

    if identifier:
        needle = identifier.lower()
        selected = []
        for path in paths:
            events = load_run_events(path)
            session_id = os.path.basename(path)[:-6]
            matching_runs = {
                event.get("runID")
                for event in events
                if str(event.get("runID", "")).lower().startswith(needle)
            }
            if session_id.lower().startswith(needle):
                selected.extend(events)
            elif matching_runs:
                selected.extend(
                    event for event in events
                    if event.get("runID") in matching_runs
                )
        if not selected:
            print(f"cantrip: no session or run matches {identifier}",
                  file=sys.stderr)
            return 1
        selected.sort(key=lambda event: (
            event.get("timestamp", ""), event.get("sequence", 0)
        ))
        for event in selected:
            timestamp = event.get("timestamp", "?")
            run_id = str(event.get("runID", ""))[:8]
            kind = event.get("kind", "unknown")
            detail = event_summary(event)
            print(f"{timestamp}  {run_id}  {kind:18} {detail}".rstrip())
        return 0

    summaries = []
    terminal = {"result", "cancelled", "conversation_reset"}
    for path in paths:
        events = load_run_events(path)
        runs = {}
        for event in events:
            run_id = event.get("runID")
            if not run_id:
                continue
            state = runs.setdefault(run_id, {
                "session": event.get("sessionID", ""),
                "started": "",
                "mode": "?",
                "prompt": "",
                "status": "unfinished",
            })
            if event.get("kind") == "turn_started":
                state.update({
                    "started": event.get("timestamp", ""),
                    "mode": event.get("mode", "single"),
                    "prompt": event.get("prompt", ""),
                    "status": "unfinished",
                })
            elif event.get("kind") in terminal:
                state["status"] = (event.get("status")
                                   or event.get("kind").replace("_", " "))
        summaries.extend((run_id, state) for run_id, state in runs.items())
    summaries.sort(key=lambda pair: pair[1]["started"], reverse=True)
    print("STARTED                       SESSION   RUN       MODE     STATUS       PROMPT")
    for run_id, state in summaries[:50]:
        print(f"{state['started'][:25]:25} "
              f"{state['session'][:8]:8}  {run_id[:8]:8}  "
              f"{state['mode'][:7]:7}  {state['status'][:11]:11}  "
              f"{state['prompt'][:80]}")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] == "runs":
        if len(args) > 2:
            print("cantrip: usage: cantrip runs [session-or-run-id]",
                  file=sys.stderr)
            return 2
        return inspect_runs(args[1] if len(args) == 2 else None)
    backend = None
    if "--backend" in args:
        i = args.index("--backend")
        try:
            backend = args[i + 1]
        except IndexError:
            print("cantrip: --backend needs a value", file=sys.stderr)
            return 2
        del args[i:i + 2]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    text = " ".join(args)
    if not sys.stdin.isatty():
        piped = sys.stdin.read().strip()
        if piped:
            text = (text + "\n\n" + piped) if text else piped
    if not text.strip():
        print("cantrip: nothing to ask (args or stdin)", file=sys.stderr)
        return 2

    request = {"text": text, "cwd": os.getcwd()}
    if backend:
        request["backend"] = backend

    try:
        sock = connect()
    except OSError:
        sock = launch_app()
        if sock is None:
            print("cantrip: app not running (no socket at ~/.cache/Cantrip) "
                  "and it couldn't be launched. Open Cantrip.app manually.",
                  file=sys.stderr)
            return 1

    sock.sendall((json.dumps(request) + "\n").encode())
    buffer = b""
    while True:
        chunk = sock.recv(65536)
        if not chunk:
            break
        buffer += chunk
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            if not line.strip():
                continue
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue
            if "delta" in msg:
                sys.stdout.write(msg["delta"])
                sys.stdout.flush()
            elif "status" in msg:
                print(f"· {msg['status']}", file=sys.stderr)
            elif "error" in msg:
                print(f"\ncantrip: {msg['error']}", file=sys.stderr)
                return 1
            elif msg.get("done"):
                print()
                return 0
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
